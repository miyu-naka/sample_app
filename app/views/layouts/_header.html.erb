<header class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
  <div class="container-fluid container">
    <%= link_to "sample app", root_path, id: "logo", class: "navbar-brand text-uppercase fw-bold fs-4" %>
    
    <button id="hamburger" class="navbar-toggler" type="button" 
            aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbar-menu">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Help", help_path, class: "nav-link" %>
        </li>
        <% if logged_in? %>
          <li class="nav-item">
            <%= link_to "Users", users_path, class: "nav-link" %>
          </li>
          <li class="nav-item dropdown">
            <a href="#" id="account" class="nav-link dropdown-toggle" role="button">
              Account
            </a>
            <ul id="dropdown-menu" class="dropdown-menu dropdown-menu-end">
              <li><%= link_to "Profile", current_user, class: "dropdown-item" %></li>
              <li><%= link_to "Settings", edit_user_path(current_user), class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to "Log out", logout_path, class: "dropdown-item",
                                       data: { "turbo-method": :delete } %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Log in", login_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</header>
